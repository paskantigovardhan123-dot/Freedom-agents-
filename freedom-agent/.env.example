# Freedom Agent Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
APP_ENV=development

# Privacy Mode: LOCAL_ONLY | PRIVATE_HYBRID | HOSTED
PRIVACY_MODE=LOCAL_ONLY

# Policy Profile: Conservative | Developer | Research | Local Experimentation
POLICY_PROFILE=Developer

# Workspace Root (Default is current working directory)
WORKSPACE_ROOT=./workspace

# Database URL (SQLite)
DATABASE_URL=sqlite:///./freedom_agent.db

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120.0

# Remote Hosted Provider Configuration (Only used in HOSTED or approved PRIVATE_HYBRID)
# Set your key via your secret manager; never commit real keys!
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Tool Execution & Sandbox Limits
MAX_TASK_DURATION_SECONDS=600
MAX_COMMAND_TIMEOUT_SECONDS=120
MAX_AGENT_RETRIES=3
MAX_PARALLEL_TASKS=4
AUTO_APPROVE_READ_ONLY_TOOLS=true
REQUIRE_APPROVAL_FOR_COMMITS=true
REQUIRE_APPROVAL_FOR_COMMANDS=true
